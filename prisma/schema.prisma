// Internal Department & Asset Management System
// PostgreSQL - multiple department heads write concurrently over the LAN.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

// The role is a starting template, not the whole story: what someone may open
// is `permissions` laid over the role's defaults (see lib/permissions.ts).
// ADMIN is the exception - always everything, and the only role that manages
// accounts.
enum Role {
  ADMIN
  DEPT_HEAD
  EMPLOYEE
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(DEPT_HEAD)
  isActive     Boolean @default(true)

  // Per-area overrides of the role's template, e.g. {"assets":"VIEW"}. Only
  // what differs is stored, so an area added later gets the role's default.
  // Read with resolveAccess, which ignores anything it does not recognise.
  permissions Json @default("{}")

  // Which departments' records this person sees. An ADMIN sees all of them
  // whatever is set here. Anyone else sees all only when allDepartments is set
  // on purpose, otherwise just departmentId - and with neither, nothing. That
  // is deliberate: a department that is deleted nulls departmentId, and that
  // must shrink someone's view, never widen it to the whole site.
  allDepartments Boolean     @default(false)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // --- Profile ---
  // Shown beside the person wherever they are assigned to something, and on
  // the printed purchase order, so the supplier knows who to expect.
  jobTitle          String?
  phone             String?
  // Same storage as asset photos: RELATIVE to VIDEO_STORAGE_DIR, downscaled
  // in the browser before upload.
  photoRelativePath String?
  photoMimeType     String?
  photoUploadedAt   DateTime?

  // Forces a password change on first login for admin-seeded accounts.
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  recordedFixes    MachineFix[]            @relation("RecordedBy")
  machinesAdded    Machine[]               @relation("MachineCreatedBy")
  fixFiles         MachineFixFile[]        @relation("FixFileUploadedBy")
  reportPresets    ReportPreset[]          @relation("ReportPresetAuthor")
  ordersCreated    PurchaseOrder[]         @relation("OrderCreatedBy")
  ordersCompleted  PurchaseOrder[]         @relation("OrderCompletedBy")
  ordersRequested  PurchaseOrder[]         @relation("OrderRequestedBy")
  ordersIssued     PurchaseOrder[]         @relation("OrderIssuedBy")
  ordersChecked    PurchaseOrder[]         @relation("OrderCheckedBy")
  ordersAuthorized PurchaseOrder[]         @relation("OrderAuthorizedBy")
  orderPhotos      PurchaseOrderPhoto[]    @relation("OrderPhotoUploadedBy")
  orderDocuments   PurchaseOrderDocument[] @relation("OrderDocumentUploadedBy")
  stockAdded       StockItem[]             @relation("StockAddedBy")
  stockMovements   StockMovement[]
  assignedOrders   PurchaseOrderAssignee[]

  @@index([departmentId])
}

model Session {
  id        String   @id @default(cuid())
  // Only the SHA-256 of the token is stored; the raw token lives in the cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Departments
// ---------------------------------------------------------------------------

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  // Short code used to build asset tags, e.g. "PRT" -> PRT-001
  code        String  @unique
  description String?
  location    String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets          Asset[]
  users           User[]
  purchaseOrders  PurchaseOrder[]
  assetCategories AssetCategory[]
  machines        Machine[]
}

// ---------------------------------------------------------------------------
// Asset categories
//
// A department's own grouping of equipment - "Nuts" under Workshop, "Presses"
// under Printing. Scoped to one department on purpose: two departments naming a
// group the same thing are not the same group, and the code below has to stay
// unique per department because it forms the middle of every asset tag.
// ---------------------------------------------------------------------------

model AssetCategory {
  id String @id @default(cuid())

  name        String
  // Short code used to build asset tags, e.g. WRK + NUT -> WRK-NUT-001.
  code        String
  description String?
  isActive    Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets     Asset[]
  orderItems PurchaseOrderItem[]

  @@unique([departmentId, name])
  @@unique([departmentId, code])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Locations
//
// A physical place on the site - "Shed B", "Line 2 - East", "Server cupboard".
// Deliberately NOT scoped to a department, unlike AssetCategory: a shed is one
// shed whoever's machine is standing in it, and the same floor routinely holds
// equipment belonging to several departments at once.
//
// Admin-only to create, which is the whole point of the table: it is what stops
// "Shed B" also existing as "shed b" and "B Shed".
// ---------------------------------------------------------------------------

model Location {
  id String @id @default(cuid())

  // Unique across the site, not per department - see above.
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets   Asset[]
  machines Machine[]
}

// ---------------------------------------------------------------------------
// Assets
// ---------------------------------------------------------------------------

enum AssetStatus {
  IN_USE
  IDLE
  NEEDS_REPLACEMENT
  BROKEN
}

model Asset {
  id       String @id @default(cuid())
  // Human-readable identifier staff actually say out loud, e.g. "PRT-001".
  assetTag String @unique

  name         String
  // How many identical units this one record stands for - five of the same
  // chair are one row, not five. Defaults to 1, which is what every row that
  // existed before this column meant.
  quantity     Int         @default(1)
  serialNumber String?
  status       AssetStatus @default(IN_USE)
  purchaseDate DateTime?
  // What ONE unit cost. The record's value is unitCost * quantity; the form can
  // take a total instead, but it is divided down before it is sent.
  // Nullable: cost is frequently unknown for older equipment.
  unitCost     Decimal?    @db.Decimal(12, 2)
  notes        String?

  // --- Photo ---
  // Path RELATIVE to VIDEO_STORAGE_DIR (photos live in an images/ subfolder of
  // the same storage root). Never absolute: the root must stay relocatable.
  // The browser downscales before upload, so this is always a small JPEG -
  // small enough to base64-inline into the PDF without bloating it.
  photoRelativePath String?
  photoOriginalName String?
  photoMimeType     String?
  photoSizeBytes    Int?
  photoUploadedAt   DateTime?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Always a category belonging to THIS asset's department - enforced in the API
  // layer, because a foreign key cannot express "same department" on its own.
  categoryId String
  category   AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Nullable, unlike the category: a great deal of older equipment has never had
  // a place written down, and demanding one would block editing those rows for
  // every other reason.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // --- Place in the Assets list (lib/asset-order.ts) ---
  // Both null until someone drags. listPosition counts within the department
  // and is written for all of it at once; listGroup is the group a row was
  // dragged into, when its name alone would not put it there.
  listPosition Int?
  listGroup    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItemsBasedOn  PurchaseOrderItem[] @relation("OrderItemBasedOn")
  // The order lines this asset was bought through - the one it was made
  // from, and any that topped its quantity up since.
  orderItemsReceived PurchaseOrderItem[] @relation("OrderItemReceived")
  // Set once someone puts the asset on the Stock page; most assets never are.
  stock              StockItem?
  stockMovements     StockMovement[]

  @@index([departmentId])
  @@index([status])
  @@index([categoryId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Suppliers and purchase orders
//
// A purchase order is a record in the system, not a document: it starts as
// the list somebody wrote by hand (photographed and attached), is handed to
// whoever does the buying, and ends with photos of what came back and what it
// cost. The printout is just one view of it.
// ---------------------------------------------------------------------------

enum SupplierKind {
  LOCAL
  INTERNATIONAL
}

// The firms things are bought from. Site-wide like Location - the same shop
// sells to every department - and kept for years, which is the point: the
// buyer's printout carries the address and the numbers without anyone
// retyping them.
model Supplier {
  id   String       @id @default(cuid())
  name String
  kind SupplierKind @default(LOCAL)

  contactPerson String?
  phone         String?
  // A second number: a shop's landline and the owner's mobile are both normal.
  altPhone      String?
  email         String?
  website       String?
  address       String?
  city          String?
  country       String?
  notes         String?

  // Logo or shopfront - how the buyer recognises the place. Same storage as
  // every other photo here: RELATIVE to VIDEO_STORAGE_DIR.
  photoRelativePath String?
  photoMimeType     String?
  photoUploadedAt   DateTime?

  // Retired rather than deleted once any order has used it, so an old order
  // still prints who it was bought from.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders PurchaseOrderSupplier[]
  items  PurchaseOrderItem[]

  @@index([kind])
}

// ---------------------------------------------------------------------------
// Reference lists - the small vocabularies an order is written in
// ---------------------------------------------------------------------------

// PCS, Kg, set, roll. Editable in Purchasing > Settings; retired rather than
// deleted once a line uses one, so an old order keeps its wording.
model Unit {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseOrderItem[]
}

// Which dropdown an option belongs to. One table rather than four that would
// differ only by their name.
enum OrderListKind {
  // Oversea only: the office the order is sent from, who at the supplier it
  // is addressed to, and the two sets of terms agreed with them.
  FROM
  ATTENTION
  DELIVERY
  PAYMENT
}

model OrderListOption {
  id        String        @id @default(cuid())
  kind      OrderListKind
  value     String
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind])
}

// The things this factory buys, typed once and offered ever after. Two levels,
// as the old system had them: a name, and the descriptions it comes in
// ("Bearing" > "6204 2RS"). It is a memory aid for writing an order, not a
// stock list - nothing here has a quantity or a price.
model CatalogueItem {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  descriptions CatalogueDescription[]
  orderItems   PurchaseOrderItem[]
}

model CatalogueDescription {
  id     String        @id @default(cuid())
  itemId String
  item   CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text   String

  @@unique([itemId, text])
  @@index([itemId])
}

// Bought down the road, or shipped in. The split the old system kept as two
// separate screens; here it is one screen with a filter, because the two
// differ by a handful of fields and nothing else.
enum PurchaseOrderKind {
  LOCAL
  OVERSEA
}

// The three tabs on the Purchasing screen, in the order an order moves.
enum PurchaseOrderStatus {
  NEW
  PENDING
  COMPLETED
}

model PurchaseOrder {
  id     String              @id @default(cuid())
  // PO-2026-0001: counts within the year, issued by nextOrderNumber behind an
  // advisory lock so two people saving at once cannot share one.
  number String              @unique
  status PurchaseOrderStatus @default(NEW)
  kind   PurchaseOrderKind   @default(LOCAL)
  note   String?

  // --- Oversea terms ---
  // Only an OVERSEA order fills these; a local one leaves them null. They are
  // free text backed by a suggestion list (OrderListOption) rather than a
  // foreign key, because the wording on a real order varies and an old order
  // must keep the words it was sent with.
  originFrom    String?
  attention     String?
  deliveryTerms String?
  paymentTerms  String?

  // --- The four sign-offs ---
  // Who wanted it, who wrote it, who checked it, who approved it: the boxes
  // at the foot of the paper order, each a different person. Separate from
  // `assignees`, which is who is looking after the order day to day and is
  // also what grants "assigned only" access - a name here does not.
  requestedById  String?
  requestedBy    User?   @relation("OrderRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  issuedById     String?
  issuedBy       User?   @relation("OrderIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  checkedById    String?
  checkedBy      User?   @relation("OrderCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  authorizedById String?
  authorizedBy   User?   @relation("OrderAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // When it left NEW, and when it was completed and by whom - the order's
  // history, without a separate log table for three events.
  sentAt        DateTime?
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("OrderCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PurchaseOrderItem[]
  suppliers PurchaseOrderSupplier[]
  assignees PurchaseOrderAssignee[]
  photos    PurchaseOrderPhoto[]
  documents PurchaseOrderDocument[]

  @@index([status])
  @@index([kind])
  @@index([departmentId])
}

model PurchaseOrderSupplier {
  orderId    String
  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId String
  // Restrict: a supplier on an order is retired, never deleted out from under it.
  supplier   Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@id([orderId, supplierId])
  @@index([supplierId])
}

// Who takes care of the order. Being assigned is also what lets someone with
// "assigned only" purchasing access see it at all.
model PurchaseOrderAssignee {
  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([orderId, userId])
  @@index([userId])
}

model PurchaseOrderItem {
  id       String        @id @default(cuid())
  orderId  String
  order    PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The order the lines were written in, which is the order they print in.
  position Int

  // The old system numbered every line "JJC-0001". Kept because the paperwork
  // in the filing cabinet quotes it.
  codeNo String?

  name    String
  details String?

  // Fractional on purpose: 2.25 Kg of something is a real line. Three places
  // is what the old data needed and more than any invoice here uses.
  quantity Decimal @default(1) @db.Decimal(12, 3)

  // PCS, Kg, set. Without it a quantity is just a number.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  // Picked from the catalogue of names typed before, when it is something
  // bought regularly. The name is still copied onto the line: renaming a
  // catalogue entry must not rewrite orders already sent.
  catalogueItemId String?
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)

  // When this line, specifically, turned up. A single order often arrives in
  // pieces over weeks.
  receivedDate DateTime?

  // One of the order department's categories - checked in the API, like an
  // asset's. Optional: plenty of what gets bought is not equipment.
  categoryId String?
  category   AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Picked from the equipment already on record ("another one of these"), for
  // its name and photo. Never changed by the order itself.
  basedOnAssetId String?
  basedOnAsset   Asset?  @relation("OrderItemBasedOn", fields: [basedOnAssetId], references: [id], onDelete: SetNull)

  // Which of the order's suppliers this line is bought from, if said.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Its own photo, for something the system has never seen.
  photoRelativePath String?
  photoMimeType     String?
  photoUploadedAt   DateTime?

  // Entered when it is bought - unknown until then, so nothing asks for it
  // earlier. Per unit, the same as Asset.unitCost, but to four places: a
  // price of $0.625 each is normal when the unit is small.
  boughtUnitPrice Decimal? @db.Decimal(12, 4)

  // The asset this line was received into once it arrived: a new one made
  // from it, or the existing one it topped up ("three more of that chair").
  // Many lines can top up one asset over the years, so this is not unique.
  // Set once; the button to do it goes away after.
  receivedAssetId String?
  receivedAsset   Asset?  @relation("OrderItemReceived", fields: [receivedAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([receivedAssetId])
  @@index([unitId])
  @@index([catalogueItemId])
}

enum PurchaseOrderPhotoKind {
  // The handwritten list or hard copy the order started from.
  SHEET
  // What was actually bought, boxed or unboxed - the proof it arrived.
  RECEIVED
}

model PurchaseOrderPhoto {
  id      String                 @id @default(cuid())
  orderId String
  order   PurchaseOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind    PurchaseOrderPhotoKind

  relativePath String
  mimeType     String

  uploadedById String?
  uploadedBy   User?   @relation("OrderPhotoUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
}

// Paperwork that came with an order and is not a photo: the supplier's
// proforma, the invoice, a quotation. Kept as the file it arrived as, and
// added to the end of the printed order when it is a PDF.
model PurchaseOrderDocument {
  id      String        @id @default(cuid())
  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // The name it had on the sender's machine - what people recognise it by.
  fileName     String
  relativePath String
  mimeType     String
  sizeBytes    Int

  uploadedById String?
  uploadedBy   User?   @relation("OrderDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Stock - assets kept on hand and refilled
// ---------------------------------------------------------------------------

// An asset someone chose to track as stock. The count is the asset's own
// quantity, not a copy - using stock lowers it, a completed order that tops
// the asset up refills it - so the two screens can never disagree.
model StockItem {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Below this the item is "running low". 0 means only an empty shelf counts.
  minLevel Int @default(0)

  // When the low-stock email last went out. Cleared once the count is back at
  // or above the limit, so one dip sends one email, not one per stock-out.
  alertedAt DateTime?

  addedById String?
  addedBy   User?    @relation("StockAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One line of a stocked asset's history: what changed its count, by how much,
// and what was left. Kept against the asset, not the StockItem, so taking an
// item off the Stock page and putting it back keeps its history.
enum StockMovementKind {
  START // put on the Stock page; change is 0, quantityAfter is the count then
  IN
  USAGE
  COUNT // a recount after checking the shelf
  EDIT  // the quantity changed on the asset's own form
  ORDER // an arrived order line topped it up; note is the order number
}

model StockMovement {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  kind          StockMovementKind
  // Signed: + came in, - went out.
  change        Int
  quantityAfter Int
  note          String?

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([assetId, createdAt])
}

// ---------------------------------------------------------------------------
// Machines - a profile per machine and its repair history, kept like versions
// ---------------------------------------------------------------------------

enum MachineStatus {
  RUNNING
  UNDER_REPAIR
  STOPPED
}

// A machine on the floor. Deliberately not an Asset: the owner keeps the two
// apart, so a machine is entered here on its own and nothing links them.
model Machine {
  id String @id @default(cuid())

  // The number painted on the machine, if it has one.
  code         String?       @unique
  name         String
  model        String?
  manufacturer String?
  serialNumber String?
  status       MachineStatus @default(RUNNING)
  installedAt  DateTime?
  notes        String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  locationId   String?
  location     Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  photoRelativePath String?
  photoMimeType     String?
  photoUploadedAt   DateTime?

  // The highest version ever given out. Fixes take lastVersion + 1, so a
  // deleted fix never hands its number to the next one.
  lastVersion Int @default(0)

  createdById String?
  createdBy   User?   @relation("MachineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fixes MachineFix[]

  @@index([departmentId])
  @@index([status])
}

// One repair, numbered per machine like a version: v1, v2, v3...
model MachineFix {
  id        String  @id @default(cuid())
  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  version   Int

  title       String
  // What was wrong, as it was reported.
  symptom     String?
  // What was done about it.
  description String
  // The person who physically did the repair. Free text on purpose: the people
  // fixing machines usually do not have app logins.
  fixedByName String
  fixedAt     DateTime @default(now())
  // The state the machine was left in; null means the fix did not change it.
  statusAfter MachineStatus?

  recordedById String
  recordedBy   User   @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  files MachineFixFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([machineId, version])
  @@index([fixedAt])
}

enum MachineFixFileKind {
  VIDEO
  PHOTO
  DOCUMENT
}

// Anything attached to a fix. Files live under VIDEO_STORAGE_DIR/machines/.
model MachineFixFile {
  id    String             @id @default(cuid())
  fixId String
  fix   MachineFix         @relation(fields: [fixId], references: [id], onDelete: Cascade)
  kind  MachineFixFileKind

  // As it was named on the phone or PC it came from.
  fileName     String
  relativePath String
  mimeType     String
  sizeBytes    BigInt

  // Videos only: the unguessable slug in the public /videos/<token>/ link,
  // which is the one thing the Cloudflare Tunnel exposes.
  token String? @unique

  uploadedById String?
  uploadedBy   User?   @relation("FixFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([fixId])
}

// ---------------------------------------------------------------------------
// Saved report setups
//
// One row is one named way of building a report - which departments and
// locations it covers, what it is grouped by, which sections it has and in what
// order, and the columns of every table. Shared across the whole site by
// design: a report the CEO expects every month should look the same whoever
// generates it and from whichever PC.
//
// The setup itself is Json, not columns. It is one opaque setting read and
// written as a whole, its shape is expected to keep moving, and splitting it
// across thirty columns would mean a migration every time a column is added to
// a table. normalizeReportConfig in reports/config.ts is what makes an older
// one safe to open.
// ---------------------------------------------------------------------------

model ReportPreset {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  config Json

  // Nullable, and SetNull rather than Cascade: these are shared, so deleting
  // the person who first saved one must not take the team's report with them.
  createdById String?
  createdBy   User?   @relation("ReportPresetAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}
