# ---------------------------------------------------------------------------
# Copy to .env and fill in:  cp .env.example .env
# NEVER commit the real .env file - it is gitignored on purpose.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# On the office PC, Postgres runs locally, so localhost is correct here even
# though the app itself is reachable across the LAN.
DATABASE_URL="postgresql://assets:CHANGE_ME@localhost:5432/assets_manager?schema=public"

# Secret used to sign session cookies. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value logs everyone out.
SESSION_SECRET="CHANGE_ME_generate_a_long_random_value"

# ---------------------------------------------------------------------------
# File storage - repair videos AND asset photos both live under this root.
#   <VIDEO_STORAGE_DIR>/<assetId>/<token>/<file>.mp4   repair videos
#   <VIDEO_STORAGE_DIR>/images/<assetId>/photo-*.jpg   asset photos
# Back up this one directory and you have both.
# ---------------------------------------------------------------------------

# Use the big drive, NOT the system drive. Must be an absolute path.
#   Windows example: D:\\assets-manager-videos
#   Linux example:   /srv/assets-manager/videos
VIDEO_STORAGE_DIR="D:\\assets-manager-videos"

# Largest single video accepted, in megabytes. (Asset photos are downscaled in
# the browser before upload and are capped separately at 6 MB.)
MAX_VIDEO_MB="1024"

# Public base URL of the Cloudflare Tunnel that exposes ONLY /videos/*.
# This is what gets printed as a clickable link inside CEO-facing PDFs, so it
# must be reachable from outside the office. Leave blank until the tunnel is
# live - reports then fall back to the LAN URL.
# NOTE: asset photos are NOT served through this; they are internal data,
# embedded directly into the PDF instead.
PUBLIC_VIDEO_BASE_URL=""

# LAN address staff use in the browser. Used for non-video links in PDFs.
LAN_BASE_URL="http://192.168.1.50:3000"

# Optional. Puppeteer normally uses the Chromium it downloads during
# `npm install`. If antivirus or a proxy blocks that download, point this at an
# already-installed Chrome or Edge instead. Leave blank to use the bundled one.
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Linux:   /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=""

# ---------------------------------------------------------------------------
# Report branding - appears at the top of every CEO-facing PDF.
# ---------------------------------------------------------------------------
COMPANY_NAME="Your Company Name"
COMPANY_TAGLINE="Internal Asset & Purchase Planning"

# Logo shown top-left of the PDF. Absolute path or path relative to the project
# root. PNG or SVG. Falls back to a typeset wordmark if the file is missing.
COMPANY_LOGO_PATH="./public/branding/logo.png"

# Currency used for purchase costs in reports.
CURRENCY_CODE="USD"
CURRENCY_LOCALE="en-US"

# Same two values again, exposed to the browser so on-screen tables and the PDF
# format money identically. Keep these in sync with the pair above.
NEXT_PUBLIC_CURRENCY_CODE="USD"
NEXT_PUBLIC_CURRENCY_LOCALE="en-US"
